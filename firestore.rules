rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection: Feature flags, profile, and account details
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only the user themselves can update their profile (features can also be administered)
      allow write: if isOwner(userId);
    }

    // 2. User Progress: XP, Study Deficit, and Penalties
    match /user_progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 3. User Daily Tasks & Schedule
    match /user_tasks/{taskId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Custom Tests & Question Banks
    match /custom_tests/{testId} {
      // Anyone authenticated can read and take tests
      allow read: if true;
      // Creation allowed if authenticated
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Only the creator can edit or delete their custom test
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || resource.data.createdBy == 'anonymous');
    }

    // 5. Study Reels & Micro-Notes
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || resource.data.createdBy == 'anonymous');
    }

    // 6. Push Notification Subscriptions
    match /push_subscriptions/{subId} {
      allow read, write: if isAuthenticated();
    }

    // Default catch-all: deny all unauthenticated writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
